#!/usr/bin/env bash
# Connects this machine to a Wrike account, once.
#
# The permanent token goes into the system keyring and nowhere else. It is
# never written to a file, never exported, never logged, and never passed as a
# command line argument, since anything in argv is readable by every process on
# the machine through ps. Credentials reach curl through a config file supplied
# on a pipe instead.
#
# The host and the account email are not secrets, but they are stored as fields
# of the same keyring entry so the credential stays a single object with a
# single writer. Nothing has to be kept in sync with shell.json, and the plugin
# can never hold half a credential.
set -euo pipefail

readonly SERVICE="omarchy-wrike"
readonly LABEL="Omarchy Wrike"
readonly TOKEN_PAGE="https://www.wrike.com"
readonly DEFAULT_HOST="www.wrike.com"
readonly HOSTS=("www.wrike.com" "app-eu.wrike.com" "app-us2.wrike.com")

BODY_FILE=""
cleanup() {
  if [[ -n $BODY_FILE ]]; then
    rm -f "$BODY_FILE"
  fi
}
trap cleanup EXIT

usage() {
  cat <<'USAGE'
Usage: omarchy-wrike-auth [--status | --clear | --help]

Connect this machine to a Wrike account. The permanent token is stored in the
system keyring and read from there at request time.

  (no arguments)  Interactive setup: host, permanent token
  --status        Show the connected host and account, never the token
  --clear         Remove the stored credential
  --help          Show this message
USAGE
}

die() {
  echo "omarchy-wrike-auth: $*" >&2
  exit 1
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 ||
    die "$1 is required but was not found on PATH"
}

# Accepts what people actually paste: a bare host, a full URL, a trailing
# slash, a deep link, or a short datacenter name (eu, us2).
normalize_host() {
  local value="$1"
  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  value="${value,,}"
  case "$value" in
  "" | www | default)
    printf '%s' "$DEFAULT_HOST"
    ;;
  eu | europe | app-eu | app-eu.wrike.com)
    printf '%s' "app-eu.wrike.com"
    ;;
  us2 | us | app-us2 | app-us2.wrike.com)
    printf '%s' "app-us2.wrike.com"
    ;;
  www.wrike.com | wrike.com)
    printf '%s' "$DEFAULT_HOST"
    ;;
  *)
    printf '%s' "$value"
    ;;
  esac
}

credential_json() {
  secret-tool lookup service "$SERVICE" 2>/dev/null || true
}

# Reads one field from the credential. The document is piped rather than passed
# as an argument or a here-string: arguments are visible in ps, and bash backs
# here-strings with a temporary file, which would put the token on disk.
credential_field() {
  local name="$1" json="$2"
  [[ -n $json ]] || return 0
  printf '%s' "$json" | jq -r --arg name "$name" '.[$name] // empty' 2>/dev/null || true
}

cmd_status() {
  require_tool secret-tool
  require_tool jq
  local json
  json=$(credential_json)
  if [[ -z $json ]]; then
    echo "Not connected. Run omarchy-wrike-auth to connect a Wrike account." >&2
    return 1
  fi
  echo "Connected to $(credential_field host "$json") as $(credential_field account "$json")"
}

cmd_clear() {
  require_tool secret-tool
  secret-tool clear service "$SERVICE"
  echo "Credential removed."
}

# Validates the credential against one base URL before anything is stored, so a
# typo never leaves a broken credential in the keyring for the widget to trip
# over later. Returns the HTTP status on stdout.
validate_credential() {
  local base="$1" token="$2" body_file="$3"
  curl --silent --show-error \
    --config <(printf 'header = "Authorization: Bearer %s"\n' "$token") \
    --header 'Accept: application/json' \
    --output "$body_file" \
    --write-out '%{http_code}' \
    --url "$base/contacts?me=true"
}

candidate_hosts() {
  local preferred="$1" host
  printf '%s\n' "$preferred"
  for host in "${HOSTS[@]}"; do
    [[ $host == "$preferred" ]] && continue
    printf '%s\n' "$host"
  done
}

cmd_setup() {
  require_tool curl
  require_tool secret-tool
  require_tool jq

  local host token
  read -r -p "Wrike host [www.wrike.com, or eu / us2]: " host
  host=$(normalize_host "${host:-}")
  [[ -n $host ]] || die "a host is required"

  cat <<INSTRUCTIONS

Create a permanent API token in Wrike:
  1. Open $TOKEN_PAGE
  2. Profile → Apps & Integrations → API
  3. Create an app if you do not have one
  4. Generate a Permanent access token

The token inherits your own permissions. This plugin only reads tasks,
spaces, and workflows.

INSTRUCTIONS
  read -r -s -p "Permanent token (input hidden): " token
  echo
  [[ -n ${token:-} ]] || die "a permanent token is required"

  local candidate base accepted_base="" accepted_host="" status http_code last_code=""
  BODY_FILE=$(mktemp)

  while IFS= read -r candidate; do
    base="https://$candidate/api/v4"
    status=0
    http_code=$(validate_credential "$base" "$token" "$BODY_FILE") || status=$?

    if ((status != 0)); then
      last_code="unreachable"
      continue
    fi

    case "$http_code" in
    200)
      accepted_base="$base"
      accepted_host="$candidate"
      break
      ;;
    401 | 403)
      last_code="$http_code"
      # A rejected token will fail on every host the same way. Do not keep
      # trying other datacenters after a clear auth failure.
      break
      ;;
    *)
      last_code="$http_code"
      ;;
    esac
  done < <(candidate_hosts "$host")

  if [[ -z $accepted_base ]]; then
    case "$last_code" in
    unreachable)
      die "could not reach Wrike, so nothing was stored"
      ;;
    401)
      die "Wrike rejected that token, so nothing was stored"
      ;;
    403)
      die "that account is authenticated but not permitted to read the API, so nothing was stored"
      ;;
    *)
      die "Wrike answered $last_code, so nothing was stored"
      ;;
    esac
  fi

  local user_id email display_name
  user_id=$(jq -r '.data[0].id // empty' <"$BODY_FILE" 2>/dev/null || true)
  email=$(jq -r '.data[0].primaryEmail // .data[0].profiles[0].email // empty' <"$BODY_FILE" 2>/dev/null || true)
  display_name=$(jq -r '
    .data[0] as $me
    | [($me.firstName // ""), ($me.lastName // "")]
    | map(select(. != ""))
    | join(" ")
  ' <"$BODY_FILE" 2>/dev/null || true)
  [[ -n $email ]] || email="$user_id"

  # jq builds the document so a token containing a quote or a backslash cannot
  # produce malformed JSON, and the result is piped straight into the keyring
  # without ever touching a file or an argument.
  jq -nc --arg host "$accepted_host" --arg account "$email" --arg base "$accepted_base" \
    --arg userId "$user_id" --arg displayName "$display_name" \
    --rawfile token <(printf '%s' "$token") \
    '{
      host: $host,
      account: $account,
      base: $base,
      userId: $userId,
      displayName: $displayName,
      token: ($token | rtrimstr("\n"))
    }' |
    secret-tool store --label="$LABEL" service "$SERVICE" account "$email"

  if [[ -n $display_name ]]; then
    echo "Connected to $accepted_host as $display_name."
  else
    echo "Connected to $accepted_host as $email."
  fi
  echo "The token is in your system keyring. It is not stored anywhere else."
}

main() {
  case "${1:-}" in
  --status) cmd_status ;;
  --clear) cmd_clear ;;
  -h | --help) usage ;;
  "") cmd_setup ;;
  *) die "unknown option: $1" ;;
  esac
}

main "$@"
