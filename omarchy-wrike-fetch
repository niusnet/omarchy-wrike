#!/usr/bin/env bash
# Fetches the Wrike work assigned to the connected account and prints one JSON
# document on stdout.
#
# Two rules govern this file.
#
# It always exits zero for anything the user can encounter: no credential, a
# locked keyring, an expired token, an unreachable network. Those are states of
# the world, not crashes, and each one is described in the payload so the panel
# can render a specific message instead of guessing from an exit code. A non
# zero exit means the helper itself is broken.
#
# It never keys off a status name. Every Wrike account names its custom
# statuses freely, so the only portable signals are the status group (Active,
# Completed, Cancelled, Deferred) and whether a task has already started.
set -euo pipefail

readonly SERVICE="omarchy-wrike"
readonly SCHEMA_VERSION=1
readonly DEFAULT_MAX=100

mode="dashboard"
search_query=""
task_id=""
spaces_filter=""
max_results="$DEFAULT_MAX"

TASKS_FILE=""
SPACES_FILE=""
WORKFLOWS_FILE=""
FOLDERS_FILE=""
COMMENTS_FILE=""
ATTACHMENTS_FILE=""
CONTACTS_FILE=""
SEARCH_FILE=""
IDS_FILE=""
cleanup() {
  [[ -n $TASKS_FILE ]] && rm -f "$TASKS_FILE"
  [[ -n $SPACES_FILE ]] && rm -f "$SPACES_FILE"
  [[ -n $WORKFLOWS_FILE ]] && rm -f "$WORKFLOWS_FILE"
  [[ -n $FOLDERS_FILE ]] && rm -f "$FOLDERS_FILE"
  [[ -n $COMMENTS_FILE ]] && rm -f "$COMMENTS_FILE"
  [[ -n $ATTACHMENTS_FILE ]] && rm -f "$ATTACHMENTS_FILE"
  [[ -n $CONTACTS_FILE ]] && rm -f "$CONTACTS_FILE"
  [[ -n $SEARCH_FILE ]] && rm -f "$SEARCH_FILE"
  [[ -n $IDS_FILE ]] && rm -f "$IDS_FILE"
  return 0
}
trap cleanup EXIT

usage() {
  cat <<'USAGE'
Usage: omarchy-wrike-fetch [--spaces ID[,ID...]] [--max N]
       omarchy-wrike-fetch --search QUERY
       omarchy-wrike-fetch --task ID
       omarchy-wrike-fetch --comment ID
       omarchy-wrike-fetch --timelog ID

Prints one JSON document describing the tasks assigned to the connected
account, or the tasks matching a search. Run omarchy-wrike-auth first to
connect an account.

  --spaces   Restrict the dashboard to these space ids
  --search   Search the whole account by permalink id or title
  --task     Fetch one task for the in-panel preview
  --comment  Post a comment; JSON {text} on stdin
  --timelog  Log time; JSON {hours,trackedDate,comment} on stdin
  --max      Maximum tasks to request, 1 to 100 (default 100)
  --help     Show this message
USAGE
}

emit() {
  local state="$1" message="$2" host="${3:-}" account="${4:-}"
  jq -n \
    --argjson schema "$SCHEMA_VERSION" \
    --arg mode "$mode" \
    --arg state "$state" \
    --arg message "$message" \
    --arg site "$host" \
    --arg account "$account" \
    '{
      schema: $schema,
      mode: $mode,
      generatedAt: (now | todate),
      state: $state,
      message: $message,
      site: $site,
      account: $account,
      tickets: [],
      projects: []
    }'
  exit 0
}

emit_results() {
  local host="$2" account="$3"
  jq -n \
    --argjson schema "$SCHEMA_VERSION" \
    --arg mode "$mode" \
    --arg site "$host" \
    --arg account "$account" \
    '{
      schema: $schema,
      mode: $mode,
      generatedAt: (now | todate),
      state: "ok",
      message: "",
      site: $site,
      account: $account,
      tickets: [],
      projects: []
    }'
  exit 0
}

# A space id is an opaque Wrike identifier. Anything that is not a plausible
# id is dropped rather than escaped, because a malformed one has no business
# reaching a query string.
sanitize_spaces() {
  local raw="$1" id cleaned=()
  raw="${raw//,/ }"
  for id in $raw; do
    if [[ $id =~ ^[A-Za-z0-9_.:-]{1,256}$ ]]; then
      cleaned+=("$id")
    fi
  done
  local IFS=,
  printf '%s' "${cleaned[*]-}"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  printf '%s' "${value%"${value##*[![:space:]]}"}"
}

# Performs one authenticated request and writes the body to a file. The token
# goes through a config file on a pipe, never through an argument.
api_request() {
  local token="$1" url="$2" out="$3"
  shift 3
  curl --silent --show-error --max-time 20 \
    --config <(printf 'header = "Authorization: Bearer %s"\n' "$token") \
    --header 'Accept: application/json' \
    --output "$out" \
    --write-out '%{http_code}' \
    --url "$url" \
    "$@"
}

CREDENTIAL=""
CREDENTIAL_STATE="ok"
read_credential() {
  local stderr_file status
  stderr_file=$(mktemp)
  status=0
  CREDENTIAL=$(secret-tool lookup service "$SERVICE" 2>"$stderr_file") || status=$?

  if ((status != 0)); then
    if [[ -s $stderr_file ]]; then
      CREDENTIAL_STATE="keyring-unavailable"
    else
      CREDENTIAL_STATE="unconfigured"
    fi
  elif [[ -z $CREDENTIAL ]]; then
    CREDENTIAL_STATE="unconfigured"
  fi

  rm -f "$stderr_file"
}

field() {
  local name="$1" json="$2"
  printf '%s' "$json" | jq -r --arg name "$name" '.[$name] // empty'
}

handle_http() {
  local code="$1" host="$2" account="$3"
  case "$code" in
  200) return 0 ;;
  401)
    emit "unauthorized" "Wrike rejected the stored token. Run omarchy-wrike-auth to reconnect." "$host" "$account"
    ;;
  403)
    emit "forbidden" "This account is not permitted to read those tasks." "$host" "$account"
    ;;
  *)
    emit "error" "Wrike answered $code." "$host" "$account"
    ;;
  esac
}

# GET /tasks (account or one space) with the shared assigned-work filters.
# Leaves the body in $1. Prints the HTTP code.
fetch_assigned() {
  local out="$1"
  shift
  local url="$1"
  shift || true
  local status=0 code
  code=$(api_request "$token" "$url" "$out" --get \
    --data-urlencode "responsibles=[\"$user_id\"]" \
    --data-urlencode 'status=["Active","Deferred"]' \
    --data-urlencode 'fields=["parentIds","superParentIds","briefDescription"]' \
    --data-urlencode "sortField=UpdatedDate" \
    --data-urlencode "sortOrder=Desc" \
    --data-urlencode "pageSize=$max_results" \
    --data-urlencode "subTasks=true" \
    "$@") || status=$?
  if ((status != 0)); then
    printf '0'
    return 0
  fi
  printf '%s' "$code"
}

merge_task_pages() {
  local dest="$1"
  shift
  if (($# == 0)); then
    printf '{"data":[]}' >"$dest"
    return 0
  fi
  jq -s '{data: [.[].data[]?]}' "$@" >"$dest"
}

# When the user follows specific spaces, query each space rather than guessing
# which parent folder belongs to which space. Account-level /tasks does not
# expose a space filter.
fetch_dashboard_tasks() {
  local dest="$1" code
  if [[ -z $spaces_filter ]]; then
    code=$(fetch_assigned "$dest" "$base/tasks")
    if [[ $code == 0 ]]; then
      emit "network-error" "Could not reach $host." "$host" "$account"
    fi
    handle_http "$code" "$host" "$account"
    return 0
  fi

  local id pages=() page
  IFS=',' read -r -a ids <<<"$spaces_filter"
  for id in "${ids[@]}"; do
    page=$(mktemp)
    code=$(fetch_assigned "$page" "$base/spaces/$id/tasks" --data-urlencode "descendants=true")
    if [[ $code == 0 ]]; then
      rm -f "$page"
      emit "network-error" "Could not reach $host." "$host" "$account"
    fi
    if [[ $code == 401 || $code == 403 ]]; then
      rm -f "$page"
      handle_http "$code" "$host" "$account"
    fi
    if [[ $code == 200 ]] && jq -e . >/dev/null 2>&1 <"$page"; then
      pages+=("$page")
    else
      rm -f "$page"
    fi
  done

  merge_task_pages "$dest" "${pages[@]+"${pages[@]}"}"
  for page in "${pages[@]+"${pages[@]}"}"; do
    rm -f "$page"
  done
}

# Account folder tree is one call. Do not request extra fields: this account
# rejects `fields=project` with 400, and the tree items have no parentIds.
# Hierarchy is recovered from childIds.
fetch_folder_index() {
  FOLDERS_FILE=$(mktemp)
  printf '{"data":[]}' >"$FOLDERS_FILE"
  local status=0 code
  code=$(api_request "$token" "$base/folders" "$FOLDERS_FILE") || status=$?
  if ((status != 0)) || [[ $code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$FOLDERS_FILE"; then
    printf '{"data":[]}' >"$FOLDERS_FILE"
  fi
}

enrich_attachment_urls() {
  local file="$1" id url tmp code status=0
  local ids=()
  mapfile -t ids < <(jq -r '.data[0:20][]?.id // empty' <"$file" 2>/dev/null || true) || true
  ((${#ids[@]} > 0)) || return 0

  local urls='{}' next
  for id in "${ids[@]}"; do
    [[ -n $id ]] || continue
    tmp=$(mktemp)
    status=0
    code=$(api_request "$token" "$base/attachments/$id/url" "$tmp") || status=$?
    url=""
    if ((status == 0)) && [[ $code == 200 ]]; then
      url=$(jq -r '.data[0].url // empty' <"$tmp" 2>/dev/null || true)
    fi
    rm -f "$tmp"
    next=$(jq -c --arg id "$id" --arg url "$url" '.[$id]=$url' <<<"$urls" 2>/dev/null || true)
    [[ -n $next ]] && urls="$next"
  done

  local enriched
  enriched=$(mktemp)
  if jq --argjson urls "$urls" '.data |= map(. + {url: ($urls[.id] // .url // "")})' \
    <"$file" >"$enriched" 2>/dev/null; then
    cat "$enriched" >"$file"
  fi
  rm -f "$enriched"
  return 0
}

fetch_preview_extras() {
  local task="$1"
  COMMENTS_FILE=$(mktemp)
  ATTACHMENTS_FILE=$(mktemp)
  CONTACTS_FILE=$(mktemp)
  printf '{"data":[]}' >"$COMMENTS_FILE"
  printf '{"data":[]}' >"$ATTACHMENTS_FILE"
  printf '{"data":[]}' >"$CONTACTS_FILE"
  [[ -n $task ]] || return 0

  local code status=0
  code=$(api_request "$token" "$base/tasks/$task/comments" "$COMMENTS_FILE" --get \
    --data-urlencode "plainText=true") || status=$?
  if ((status != 0)) || [[ $code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$COMMENTS_FILE"; then
    printf '{"data":[]}' >"$COMMENTS_FILE"
  fi

  status=0
  code=$(api_request "$token" "$base/tasks/$task/attachments" "$ATTACHMENTS_FILE") || status=$?
  if ((status != 0)) || [[ $code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$ATTACHMENTS_FILE"; then
    printf '{"data":[]}' >"$ATTACHMENTS_FILE"
  elif [[ ${enrich_urls:-0} == 1 ]]; then
    enrich_attachment_urls "$ATTACHMENTS_FILE"
  fi

  local authors
  authors=$(jq -r '[.data[]?.authorId // empty] | unique | join(",")' <"$COMMENTS_FILE" 2>/dev/null || true)
  if [[ -n $authors ]]; then
    status=0
    code=$(api_request "$token" "$base/contacts/$authors" "$CONTACTS_FILE") || status=$?
    if ((status != 0)) || [[ $code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$CONTACTS_FILE"; then
      printf '{"data":[]}' >"$CONTACTS_FILE"
    fi
  fi
}

post_comment() {
  local task="$1"
  local line text status=0 code file
  IFS= read -r line || true
  text=$(printf '%s' "$line" | jq -r '.text // empty' 2>/dev/null || true)
  [[ -n $text ]] || emit "error" "A comment needs text." "$host" "$account"
  file=$(mktemp)
  code=$(api_request "$token" "$base/tasks/$task/comments" "$file" \
    --request POST --data-urlencode "text=$text" --data-urlencode "plainText=true") || status=$?
  rm -f "$file"
  if ((status != 0)); then
    emit "network-error" "Could not reach $host." "$host" "$account"
  fi
  handle_http "$code" "$host" "$account"
}

post_timelog() {
  local task="$1"
  local line hours date note status=0 code file
  IFS= read -r line || true
  hours=$(printf '%s' "$line" | jq -r '.hours // empty' 2>/dev/null || true)
  date=$(printf '%s' "$line" | jq -r '.trackedDate // empty' 2>/dev/null || true)
  note=$(printf '%s' "$line" | jq -r '.comment // empty' 2>/dev/null || true)
  [[ -n $hours ]] || emit "error" "Hours are required to log time." "$host" "$account"
  [[ -n $date ]] || date=$(date -u +%Y-%m-%d)
  file=$(mktemp)
  code=$(api_request "$token" "$base/tasks/$task/timelogs" "$file" \
    --request POST \
    --data-urlencode "hours=$hours" \
    --data-urlencode "trackedDate=$date" \
    --data-urlencode "comment=$note") || status=$?
  rm -f "$file"
  if ((status != 0)); then
    emit "network-error" "Could not reach $host." "$host" "$account"
  fi
  handle_http "$code" "$host" "$account"
}

search_by_permalink() {
  local query="$1" status=0 code api_id
  IDS_FILE=$(mktemp)
  code=$(api_request "$token" "$base/ids" "$IDS_FILE" --get \
    --data-urlencode "ids=[\"$query\"]" \
    --data-urlencode "type=ApiV2Task") || status=$?
  if ((status != 0)); then
    emit "network-error" "Could not reach $host." "$host" "$account"
  fi
  if [[ $code == 401 || $code == 403 ]]; then
    handle_http "$code" "$host" "$account"
  fi
  if [[ $code != 200 ]]; then
    printf '{"data":[]}'
    return 0
  fi
  api_id=$(jq -r '.data[0].id // empty' <"$IDS_FILE" 2>/dev/null || true)
  if [[ -z $api_id ]]; then
    printf '{"data":[]}'
    return 0
  fi
  search_by_api_id "$api_id"
}

search_by_api_id() {
  local id="$1" status=0 code file
  file=$(mktemp)
  # Single-task GET already includes description, parents, and hasAttachments.
  # Asking for those as `fields` is a 400 on this API and drops the whole preview.
  code=$(api_request "$token" "$base/tasks/$id" "$file" --get \
    --data-urlencode 'fields=["effortAllocation","attachmentCount"]') || status=$?
  if ((status != 0)); then
    rm -f "$file"
    emit "network-error" "Could not reach $host." "$host" "$account"
  fi
  if [[ $code == 401 || $code == 403 ]]; then
    rm -f "$file"
    handle_http "$code" "$host" "$account"
  fi
  if [[ $code != 200 ]] || ! jq -e . >/dev/null 2>&1 <"$file"; then
    rm -f "$file"
    printf '{"data":[]}'
    return 0
  fi
  cat "$file"
  rm -f "$file"
}

search_by_title() {
  local query="$1" status=0 code
  SEARCH_FILE=$(mktemp)
  code=$(api_request "$token" "$base/tasks" "$SEARCH_FILE" --get \
    --data-urlencode "title=$query" \
    --data-urlencode 'fields=["parentIds","superParentIds","briefDescription"]' \
    --data-urlencode "sortField=UpdatedDate" \
    --data-urlencode "sortOrder=Desc" \
    --data-urlencode "pageSize=$max_results" \
    --data-urlencode "subTasks=true") || status=$?
  if ((status != 0)); then
    emit "network-error" "Could not reach $host." "$host" "$account"
  fi
  if [[ $code == 401 || $code == 403 ]]; then
    handle_http "$code" "$host" "$account"
  fi
  if [[ $code != 200 ]]; then
    printf '{"data":[]}'
    return 0
  fi
  cat "$SEARCH_FILE"
}

while (($# > 0)); do
  case "$1" in
  --spaces)
    spaces_filter=$(sanitize_spaces "${2:-}")
    shift 2
    ;;
  --search)
    mode="search"
    search_query="${2:-}"
    shift 2
    ;;
  --task)
    mode="preview"
    task_id="${2:-}"
    shift 2
    ;;
  --attachments)
    mode="attachments"
    task_id="${2:-}"
    shift 2
    ;;
  --comment)
    mode="comment"
    task_id="${2:-}"
    shift 2
    ;;
  --timelog)
    mode="timelog"
    task_id="${2:-}"
    shift 2
    ;;
  --max)
    max_results="${2:-$DEFAULT_MAX}"
    [[ $max_results =~ ^[0-9]+$ ]] || {
      echo "omarchy-wrike-fetch: --max must be a number" >&2
      exit 2
    }
    ((max_results < 1)) && max_results=1
    ((max_results > 100)) && max_results=100
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "omarchy-wrike-fetch: unknown option: $1" >&2
    exit 2
    ;;
  esac
done

for tool in curl jq; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "omarchy-wrike-fetch: $tool is required but was not found on PATH" >&2
    exit 2
  }
done

command -v secret-tool >/dev/null 2>&1 ||
  emit "keyring-unavailable" "secret-tool was not found. Install libsecret to store the Wrike token."

read_credential
case "$CREDENTIAL_STATE" in
keyring-unavailable)
  emit "keyring-unavailable" "The system keyring did not answer. Check that gnome-keyring is running."
  ;;
unconfigured)
  emit "unconfigured" "Not connected to Wrike. Run omarchy-wrike-auth to connect an account."
  ;;
esac

host=$(field host "$CREDENTIAL")
account=$(field account "$CREDENTIAL")
base=$(field base "$CREDENTIAL")
token=$(field token "$CREDENTIAL")
user_id=$(field userId "$CREDENTIAL")

if [[ -z $host || -z $account || -z $base || -z $token || -z $user_id ]]; then
  emit "unconfigured" "The stored Wrike credential is incomplete. Run omarchy-wrike-auth again."
fi

if [[ $mode == "comment" || $mode == "timelog" ]]; then
  trimmed_query=$(trim "$task_id")
  [[ -n $trimmed_query ]] || emit "error" "A task id is required." "$host" "$account"
  if [[ $mode == "comment" ]]; then
    post_comment "$trimmed_query"
  else
    post_timelog "$trimmed_query"
  fi
  mode="preview"
  task_id="$trimmed_query"
fi

TASKS_FILE=$(mktemp)
printf '{"data":[]}' >"$TASKS_FILE"

if [[ $mode == "search" ]]; then
  trimmed_query=$(trim "$search_query")
  if [[ -z $trimmed_query ]]; then
    emit_results "" "$host" "$account"
  fi

  if [[ $trimmed_query =~ ^[0-9]+$ ]]; then
    search_by_permalink "$trimmed_query" >"$TASKS_FILE"
  elif [[ $trimmed_query =~ ^[A-Za-z0-9]{16,256}$ ]]; then
    search_by_api_id "$trimmed_query" >"$TASKS_FILE"
  else
    search_by_title "$trimmed_query" >"$TASKS_FILE"
  fi
elif [[ $mode == "preview" || $mode == "attachments" ]]; then
  trimmed_query=$(trim "$task_id")
  if [[ -z $trimmed_query ]]; then
    emit_results "" "$host" "$account"
  fi
  if [[ $trimmed_query =~ ^[0-9]+$ ]]; then
    search_by_permalink "$trimmed_query" >"$TASKS_FILE"
  else
    search_by_api_id "$trimmed_query" >"$TASKS_FILE"
  fi
else
  fetch_dashboard_tasks "$TASKS_FILE"
fi

jq -e . >/dev/null 2>&1 <"$TASKS_FILE" ||
  emit "error" "Wrike returned a response this plugin could not read." "$host" "$account"

SPACES_FILE=$(mktemp)
printf '{"data":[]}' >"$SPACES_FILE"
WORKFLOWS_FILE=$(mktemp)
printf '{"data":[]}' >"$WORKFLOWS_FILE"
FOLDERS_FILE=$(mktemp)
printf '{"data":[]}' >"$FOLDERS_FILE"
COMMENTS_FILE=$(mktemp)
printf '{"data":[]}' >"$COMMENTS_FILE"
ATTACHMENTS_FILE=$(mktemp)
printf '{"data":[]}' >"$ATTACHMENTS_FILE"
CONTACTS_FILE=$(mktemp)
printf '{"data":[]}' >"$CONTACTS_FILE"

if [[ $mode == "dashboard" ]]; then
  spaces_status=0
  spaces_code=$(api_request "$token" "$base/spaces" "$SPACES_FILE" --get \
    --data-urlencode "userIsMember=true") || spaces_status=$?
  if ((spaces_status != 0)) || [[ $spaces_code != 200 ]] ||
    ! jq -e . >/dev/null 2>&1 <"$SPACES_FILE"; then
    printf '{"data":[]}' >"$SPACES_FILE"
  fi

  workflows_status=0
  workflows_code=$(api_request "$token" "$base/workflows" "$WORKFLOWS_FILE") || workflows_status=$?
  if ((workflows_status != 0)) || [[ $workflows_code != 200 ]] ||
    ! jq -e . >/dev/null 2>&1 <"$WORKFLOWS_FILE"; then
    printf '{"data":[]}' >"$WORKFLOWS_FILE"
  fi

  fetch_folder_index
elif [[ $mode == "preview" || $mode == "attachments" ]]; then
  preview_id=$(jq -r '.data[0].id // empty' <"$TASKS_FILE" 2>/dev/null || true)
  [[ -n $preview_id ]] || preview_id=$(trim "$task_id")
  enrich_urls=0
  [[ $mode == "attachments" ]] && enrich_urls=1
  fetch_preview_extras "$preview_id"
fi

# Shared jq used to turn a Wrike task into the panel's row shape. Custom
# status names are labels; the category is always derived from the group and
# from whether the task has already started.
jq -n \
  --argjson schema "$SCHEMA_VERSION" \
  --arg mode "$mode" \
  --arg site "$host" \
  --arg account "$account" \
  --arg spacesFilter "$spaces_filter" \
  --slurpfile tasks "$TASKS_FILE" \
  --slurpfile spaces "$SPACES_FILE" \
  --slurpfile workflows "$WORKFLOWS_FILE" \
  --slurpfile folders "$FOLDERS_FILE" \
  --slurpfile comments "$COMMENTS_FILE" \
  --slurpfile attachments "$ATTACHMENTS_FILE" \
  --slurpfile contacts "$CONTACTS_FILE" \
  '
  def parse_date:
    if . == null or . == "" then empty
    elif test("Z$") then fromdateiso8601
    elif test("T") then (. + "Z" | fromdateiso8601)
    else (. + "T00:00:00Z" | fromdateiso8601)
    end;

  def started:
    (.dates.type // "") as $type
    | if $type == "Planned" then
        ((.dates.start // "") | parse_date? // null) as $start
        | $start != null and $start <= now
      elif $type == "Milestone" then
        ((.dates.due // "") | parse_date? // null) as $due
        | $due != null and $due <= now
      else
        false
      end;

  def category:
    if (.status == "Completed" or .status == "Cancelled") then "done"
    elif (.status == "Active" and started) then "indeterminate"
    else "new"
    end;

  def permalink_key:
    (.permalink // "") as $p
    | if ($p | test("id=[0-9]+")) then ($p | capture("id=(?<id>[0-9]+)") | .id)
      else .id
      end;

  ($workflows[0].data // []) as $flows
  | (
      [ $flows[]?.customStatuses[]? | {id, name, group} ]
      | map({key: .id, value: .})
      | from_entries
    ) as $statusById
  | ($spaces[0].data // []) as $spaceList
  | (
      $spaceList
      | map({key: .id, value: {id, title}})
      | from_entries
    ) as $spaceById
  | (
      ($folders[0].data // [])
      | map({key: .id, value: .})
      | from_entries
    ) as $folderById
  | (
      [ ($folders[0].data // [])[] | . as $folder | (($folder.childIds // [])[] | {key: ., value: $folder.id}) ]
      | from_entries
    ) as $parentByChild
  | (
      [ ($contacts[0].data // [])[] | {key: .id, value: (([.firstName // "", .lastName // ""] | map(select(. != "")) | join(" ")) )} ]
      | from_entries
    ) as $contactById
  | (
      $spacesFilter
      | if . == "" then [] else split(",") end
    ) as $followed

  | def is_project($folder):
      ($folder.project != null) and ($folder.project != false);

  def up($id):
    if $id == null or $id == "" then empty
    else
      $id,
      (if $spaceById[$id] != null then empty else up($parentByChild[$id]) end)
    end;

  def locate:
    ((.parentIds // []) + (.superParentIds // [])) as $starts
    | [ $starts[] | up(.) ] as $chain
    | {
        space: ([ $chain[] | $spaceById[.] | select(. != null) ] | .[0] // null),
        project: ([ $chain[] | $folderById[.] | select(. != null and is_project(.)) ] | .[0] // null),
        folder: ($folderById[$starts[0]] // null),
        chain: $chain
      };

  def in_followed:
    if ($followed | length) == 0 then true
    else
      (locate.space.id // "") as $sid
      | ($followed | index($sid) != null)
        or ((.parentIds // []) + (.superParentIds // []) | any(.; ($followed | index(.) != null)))
    end;

  def row:
    (locate) as $place
    | ($statusById[.customStatusId] // null) as $custom
    | (($place.space.title // "") ) as $spaceName
    | (($place.project.title // "") ) as $projectName
    | {
        key: permalink_key,
        id: .id,
        summary: (.title // ""),
        type: (.dates.type // "Backlog"),
        status: (($custom.name // .status) // ""),
        statusCategory: category,
        importance: (.importance // ""),
        spaceKey: ($place.space.id // ""),
        spaceName: $spaceName,
        projectKey: ($place.project.id // $place.space.id // ""),
        projectName: (if $projectName != "" then $projectName else $spaceName end),
        folderName: ($place.folder.title // ""),
        breadcrumb: (
          [
            (if $place.space != null then {id: $place.space.id, title: $place.space.title, kind: "space"} else empty end),
            (if $place.project != null then {id: $place.project.id, title: $place.project.title, kind: "project"} else empty end),
            (if $place.folder != null and ($place.project == null or $place.folder.id != $place.project.id) and ($place.space == null or $place.folder.id != $place.space.id)
             then {id: $place.folder.id, title: $place.folder.title, kind: "folder"}
             else empty end)
          ]
        ),
        updated: (.updatedDate // ""),
        url: (.permalink // ""),
        start: (.dates.start // ""),
        due: (.dates.due // ""),
        effortMinutes: ((.effortAllocation.allocatedEffort // .effortAllocation.totalEffort // 0)),
        brief: (.briefDescription // ""),
        description: (if ($mode == "preview" or $mode == "attachments") then (.description // .briefDescription // "") else (.briefDescription // "") end),
        attachmentCount: ((.attachmentCount // 0)),
        hasAttachments: ((.hasAttachments // false) or ((.attachmentCount // 0) > 0)),
        attachments: (if ($mode == "preview" or $mode == "attachments") then
          [ ($attachments[0].data // [])[] | {
              id: .id,
              name: (.name // .fileName // "Attachment"),
              url: (.url // .permalink // "")
            } ]
        else [] end),
        comments: (if ($mode == "preview" or $mode == "attachments") then
          [ ($comments[0].data // [])[] | {
              id: .id,
              author: ($contactById[.authorId] // .authorId // ""),
              created: (.createdDate // ""),
              text: (.text // "")
            } ]
        else [] end)
      };

  {
      schema: $schema,
      mode: $mode,
      generatedAt: (now | todate),
      state: "ok",
      message: "",
      site: $site,
      account: $account,
      tickets: [
        ($tasks[0].data // [])[]
        | select($mode == "search" or $mode == "preview" or $mode == "attachments" or (.status != "Completed" and .status != "Cancelled"))
        | select(in_followed)
        | row
      ],
      projects: [
        $spaceList[]
        | { key: .id, name: (.title // .id) }
      ]
    }
  '
